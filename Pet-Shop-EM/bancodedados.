create database petshop;

use petshop;

create table produtos(id_produtos bigint primary key auto_increment not null,
						nome_produto varchar(45) not null,
                        tipo_produto varchar(45) not null,
                        data_de_fabricacao datetime not null,
                        data_de_validade datetime not null,
                        tipo_pet varchar(45) not null,
                        quantidade_produto int not null);
                        
create table venda(id_venda bigint primary key auto_increment not null,
						valor_da_compra float not null,
                        quantidade_itens int not null,
                        id_produtos bigint,
                        foreign key(id_produtos) references produtos(id_produtos));
                        
create table serviços(id_serviço bigint primary key auto_increment not null,
						tipo_serviço varchar(45) not null,
                        valor_do_serviço float not null,
                        tipo_pet varchar(45) not null,
                        quantidade_pets int not null);
                        
create table estoque (
					id_produtos bigint,
                    foreign key (id_produtos) references produtos(id_produtos));
                    
